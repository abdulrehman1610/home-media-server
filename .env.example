# ─────────────────────────────────────────────────────────────
# Local Media Server Configuration Template (.env.example)
# Rename this file to .env and configure your secrets.
# ─────────────────────────────────────────────────────────────

# Authentication Credentials
MEDIA_USER=admin
MEDIA_PASS=ChangeThisPassword123!

# 2FA 6-Digit Security PIN (Leave blank to disable PIN requirement)
MEDIA_PIN=123456

# Server Network Binding
MEDIA_HOST=0.0.0.0
MEDIA_PORT=8000

# Optional: Default Folder to open on startup (e.g. C:\Users\Username\Videos or E:\Movies)
# Leave blank to start at the Storage Hub (connected drives list)
DEFAULT_PATH=
